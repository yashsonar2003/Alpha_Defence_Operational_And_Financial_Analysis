    <worksheet name='Cross-Border Delivery Lead Time Heatmap'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontname='Georgia' fontsize='14'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Alpha_Defence_Data' name='federated.1rsnvx21w9tjnq1gzx3tu00t4i95' />
          </datasources>
          <datasource-dependencies datasource='federated.1rsnvx21w9tjnq1gzx3tu00t4i95'>
            <column datatype='date' name='[Actual Delivery Date]' role='dimension' type='ordinal' />
            <column caption='Delivery Lead Time (Days)' datatype='integer' name='[Calculation_1227920321486848]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [Order Date], [Actual Delivery Date])' />
            </column>
            <column datatype='string' name='[Delivery Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='date' name='[Order Date]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Security Clearance Level]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1227920321486848]' derivation='Avg' name='[avg:Calculation_1227920321486848:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Delivery Country]' derivation='None' name='[none:Delivery Country:nk]' pivot='key' type='nominal' />
