      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1rsnvx21w9tjnq1gzx3tu00t4i95].[sum:Gross Margin USD:qk]&quot;' value='Gross Margin' />
          <alias key='&quot;[federated.1rsnvx21w9tjnq1gzx3tu00t4i95].[sum:Total Contract Value USD:qk]&quot;' value='Total Contract Value' />
          <alias key='&quot;[federated.1rsnvx21w9tjnq1gzx3tu00t4i95].[usr:Calculation_0876076247097347:qk]&quot;' value='Avg. Quality Control Score' />
        </aliases>
      </column>
      <column caption='Production Cost Ratio %' datatype='real' default-format='p0.0%' name='[Calculation_0606422087741440]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Production Cost USD]) / SUM([Total Contract Value USD])' />
      </column>
      <column caption='QC Risk Tier' datatype='string' name='[Calculation_0606422090780673]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Quality Control Score] &gt;= 95 THEN &apos;High Quality (&gt;=95)&apos;&#13;&#10;ELSEIF [Quality Control Score] &gt;= 90 THEN &apos;Acceptable (90-94.9)&apos;&#13;&#10;ELSE &apos;High Risk (&lt;90)&apos;&#13;&#10;END' />
      </column>
      <column caption='Quality Risk Tier' datatype='string' name='[Calculation_0606422101012482]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Quality Control Score] &gt;= 95 THEN &quot;Low Risk (95+)&quot;&#13;&#10;ELSEIF [Quality Control Score] &gt;= 90 THEN &quot;Medium Risk (90-94.9)&quot;&#13;&#10;ELSE &quot;High Risk (&lt;90)&quot;&#13;&#10;END' />
      </column>
      <column caption='Total Revenue' datatype='integer' name='[Calculation_0876076246781952]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Total Contract Value USD])' />
      </column>
      <column caption='Total Gross Margin' datatype='real' name='[Calculation_0876076246945793]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Gross Margin USD])' />
      </column>
      <column caption='Gross Margin %' datatype='real' default-format='p0.0%' name='[Calculation_0876076247031810]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Gross Margin USD]) / SUM([Total Contract Value USD])' />
      </column>
      <column caption='Average QC Score' datatype='real' name='[Calculation_0876076247097347]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Quality Control Score])' />
      </column>
      <column caption='On-Time Delivery Rate %' datatype='real' name='[Calculation_0876076247187460]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [Delivery Status] = &apos;Delivered On Time&apos; THEN [Order ID] END) / COUNTD([Order ID])' />
      </column>
      <column caption='Delivery Lead Time (Days)' datatype='integer' name='[Calculation_1227920321486848]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [Order Date], [Actual Delivery Date])' />
      </column>
      <column caption='Schedule Variance (Days)' datatype='integer' name='[Calculation_1227920321724417]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [Scheduled Delivery Date], [Actual Delivery Date])' />
      </column>
      <column caption='Variance KPI Status' datatype='string' name='[Calculation_1227920339189764]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1227920321724417] &gt; 0 THEN &quot;Delayed&quot;&#13;&#10;ELSEIF [Calculation_1227920321724417] = 0 THEN &quot;On-Time&quot;&#13;&#10;ELSE &quot;Ahead of Schedule&quot;&#13;&#10;END' />
      </column>
